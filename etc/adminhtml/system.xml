<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="productfeed" translate="label" sortOrder="200" showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>Product Feed Generator</label>
            <tab>catalog</tab>
            <resource>Ahsan_ProductFeed::config</resource>
            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General Settings</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Feed Generation</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="format" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Feed Format</label>
                    <source_model>Ahsan\ProductFeed\Model\Config\Source\FeedFormat</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="filename" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Output Filename</label>
                    <comment>File is written to var/export/. Extension is added automatically based on the selected format.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="attributes" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Feed Attributes</label>
                <field id="included_attributes" translate="label" type="multiselect" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Attributes to Include</label>
                    <source_model>Ahsan\ProductFeed\Model\Config\Source\ProductAttributes</source_model>
                    <comment>Only the attributes selected here are written to the feed. Nothing is hard-coded — adding or removing an attribute is a configuration change, not a code change.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="category_ids" translate="label" type="multiselect" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Limit to Categories</label>
                    <source_model>Ahsan\ProductFeed\Model\Config\Source\Categories</source_model>
                    <comment>Leave empty to include products from all categories.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
